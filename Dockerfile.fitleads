# fit-leads build of Kaneo: the official 2.49.0 image with only the web bundle
# replaced by one built from this branch (fitleads/v2.49.0-new-task-filters).
# The branch changes web code only, so the API, nginx and entrypoint come
# unchanged from the pinned upstream image.
#
#   docker build -f Dockerfile.fitleads -t kaneo-fitleads:2.49.0-filters .
#
# The web-builder stage mirrors the one in Dockerfile.kaneo. Keep the base
# image digest in sync with the one pinned in the server's compose file.

FROM node:24.22.2-alpine AS web-builder

RUN apk add --no-cache python3 make g++ && \
  corepack enable && \
  corepack prepare pnpm@12.15.0 --activate

WORKDIR /app

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json vite.config.ts ./
COPY patches ./patches
COPY apps/web/package.json ./apps/web/
COPY packages/typescript-config/package.json ./packages/typescript-config/
COPY packages/libs/package.json ./packages/libs/
COPY packages/typescript-config ./packages/typescript-config
COPY packages/libs ./packages/libs
COPY packages/permissions ./packages/permissions
COPY packages/editor ./packages/editor
COPY i18n ./i18n
COPY apps/web ./apps/web

RUN pnpm install --frozen-lockfile

WORKDIR /app/packages/permissions
RUN pnpm run build

WORKDIR /app/packages/editor
RUN pnpm run build

# The vite build is memory hungry; cap node's heap so a build on the shared
# VPS cannot starve the other containers.
WORKDIR /app/apps/web
ENV NODE_OPTIONS=--max-old-space-size=1536
RUN pnpm run build && find dist -type f -name '*.map' -delete

FROM ghcr.io/usekaneo/kaneo:2.49.0@sha256:cd1826b1aba3ce736015cadf6f6c975d923aac00f4b6aaa7aedb29bc722dae49

USER root
RUN rm -rf /usr/share/nginx/html/*
COPY --from=web-builder --chown=appuser:appuser /app/apps/web/dist /usr/share/nginx/html
USER 1001:0
